CONFIG_BACKLIGHT_QCOM_WLED=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BATTERY_QCOM_FG=m
CONFIG_DRM_PANEL_MOTOROLA_SANDERS_DJN_ILI7807D=y
CONFIG_DRM_PANEL_MOTOROLA_SANDERS_TIANMA_NT35596=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_LEDS_ATC=m
CONFIG_NFC_HCI=m
CONFIG_USB_DWC3_GADGET=y

# The working donor also carries GLINK over SMEM; qcom_wcnss_pil pulls it
# into the remoteproc dependency chain on this mainline configuration.
CONFIG_RPMSG_QCOM_GLINK_SMEM=m
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
# Sanders uses a RNDIS-only gadget; do not build unused gadget functions.
# CONFIG_USB_CONFIGFS_SERIAL is not set
# CONFIG_USB_CONFIGFS_ACM is not set
# CONFIG_USB_CONFIGFS_OBEX is not set
# CONFIG_USB_CONFIGFS_NCM is not set
# CONFIG_USB_CONFIGFS_ECM is not set
# CONFIG_USB_CONFIGFS_ECM_SUBSET is not set
# CONFIG_USB_CONFIGFS_EEM is not set
# CONFIG_USB_CONFIGFS_MASS_STORAGE is not set
# CONFIG_USB_CONFIGFS_F_FS is not set
CONFIG_USB_CONFIGFS_RNDIS=y
# CONFIG_USB_F_ACM is not set
CONFIG_NFC=m
CONFIG_NFC_PN544_I2C=m
CONFIG_NFC_SHDLC=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_GPIO=y
CONFIG_REGULATOR_QCOM_LABIBB=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=m
CONFIG_SND_SOC_CS35L35=m
